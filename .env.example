# Copy to .env and fill in. Never commit real values.

# Database (docker-compose.yml maps Postgres to host port 5433 by default)
DATABASE_URL=postgresql://jobify:jobify@localhost:5433/jobify
# Production (Neon): DATABASE_URL is the pooled string (host ends in -pooler) and
# DATABASE_URL_UNPOOLED the direct one, which Prisma migrations use. Not needed locally.
# DATABASE_URL_UNPOOLED=

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Auth. Generate a secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Proxies allowed to set X-Forwarded-For (rate limits use the client IP). In production: the
# number of proxy hops in front of the API, or their IP range.
TRUST_PROXY=loopback

# Web (server-side only): where Next.js proxies /api and fetches during SSR.
# Also needed at BUILD time: Next.js bakes the /api rewrite target into the build.
API_URL=http://localhost:4000

# Object storage (S3 API). Defaults match the SeaweedFS service in docker-compose.yml.
# For Neon Object Storage (production): S3_ENDPOINT=<AWS_ENDPOINT_URL_S3>, S3_REGION=<AWS_REGION>,
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY = Neon's AWS_* keys, S3_FORCE_PATH_STYLE=true (path-style only).
# For Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=jobify
S3_ACCESS_KEY_ID=jobify
S3_SECRET_ACCESS_KEY=jobify-dev-secret
S3_FORCE_PATH_STYLE=true

# Video interviews (LiveKit). Defaults match the dev server in docker-compose.yml.
# Production: a LiveKit Cloud project's wss URL, API key and secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Email. Locally every email goes to Mailpit (docker-compose): inbox at http://localhost:8025.
# Production: set BREVO_API_KEY (free plan) and MAIL_FROM to a sender verified in Brevo. Without
# BREVO_API_KEY in production, email is off. Seeded demo accounts never get real email.
EMAIL_ENABLED=true
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Jobify <no-reply@jobify.local>"
# BREVO_API_KEY=
# Interview times in emails are shown in this zone.
EMAIL_TIME_ZONE=Asia/Dhaka
