{
  "name": "jobify",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @jobify/db db:migrate",
    "db:deploy": "pnpm --filter @jobify/db db:deploy",
    "db:seed": "pnpm --filter @jobify/db db:seed",
    "db:reset": "pnpm --filter @jobify/db db:reset",
    "db:studio": "pnpm --filter @jobify/db db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6"
  }
}
